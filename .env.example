# CyberShield AI — Environment Configuration Example
# Copy this file to .env and configure values before starting the application.
# NEVER commit real secret keys, database credentials, or API keys into git.

# Application
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security (Generate a secure 64-character secret with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-very-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: local SQLite. For PostgreSQL: postgresql://user:password@localhost:5432/cybershield
DATABASE_URL=sqlite:///./cybershield.db

# Project Creator & Host Super Admin
OWNER_NAME=Thallapaka Jagadiswar
OWNER_EMAIL=jagadishkrishna7@gmail.com
OWNER_WEBSITE=https://www.audit3a.com/

# Optional External AI API Key (for external LLM enhancements)
# OPENAI_API_KEY=your-api-key-here
